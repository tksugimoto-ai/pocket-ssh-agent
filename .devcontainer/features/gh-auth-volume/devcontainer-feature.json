{
    "id": "gh-auth-volume",
    "version": "1.0.0",
    "name": "gh Auth Volume Mount",
    "description": "Mounts ~/.config/gh as a named volume so the gh token survives rebuilds, and wires it into git",
    "installsAfter": [
        "ghcr.io/devcontainers/features/github-cli"
    ],
    "mounts": [
        {
            "source": "pocket-ssh-agent-gh-auth",
            "target": "/home/vscode/.config/gh",
            "type": "volume"
        }
    ],
    "postCreateCommand": "sudo chown $(id -un):$(id -gn) /home/vscode/.config /home/vscode/.config/gh && chmod 700 /home/vscode/.config/gh",
    "postStartCommand": "gh auth setup-git || true"
}
